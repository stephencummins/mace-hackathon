# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Claude Model Configuration
CLAUDE_MODEL=claude-sonnet-4-6

# Optional: Output settings
OUTPUT_FORMAT=html
REPORT_DIR=reports/

# Optional: Validation strictness
VALIDATION_LEVEL=standard  # strict, standard, or lenient

# Required when running the HTTP service (src.api.main:app)
# Clients must send 'Authorization: Bearer <this-value>' on /validate.
# The server refuses to start if this is unset.
API_TOKEN=change-me-to-something-secret
